{
  "expo": {
    "name": "Motto",
    "slug": "motto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSHumanReadableCopyright": "© 2026 D2P Technology"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Motto",
      "backgroundColor": "#101410"
    },
    "backgroundColor": "#101410",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101410"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "company": "D2P Technology",
      "monetization": {
        "_note": "PLACEHOLDER_ ile başlayan her değer mağaza hesapları açılınca doldurulur: docs/design/14-satin-alma-altyapisi.md §5",
        "revenueCat": {
          "iosApiKey": "PLACEHOLDER_REVENUECAT_IOS_PUBLIC_SDK_KEY",
          "androidApiKey": "PLACEHOLDER_REVENUECAT_ANDROID_PUBLIC_SDK_KEY"
        },
        "productIds": {
          "ios": {
            "no_ads": "PLACEHOLDER_com.d2ptechnology.motto.no_ads",
            "torpil": "PLACEHOLDER_com.d2ptechnology.motto.torpil",
            "tickets_5": "PLACEHOLDER_com.d2ptechnology.motto.tickets_5",
            "season_2701": "PLACEHOLDER_com.d2ptechnology.motto.season_2701"
          },
          "android": {
            "no_ads": "PLACEHOLDER_no_ads",
            "torpil": "PLACEHOLDER_torpil",
            "tickets_5": "PLACEHOLDER_tickets_5",
            "season_2701": "PLACEHOLDER_season_2701"
          }
        },
        "legal": {
          "termsUrl": "PLACEHOLDER_https://example.com/motto/terms",
          "privacyUrl": "PLACEHOLDER_https://example.com/motto/privacy"
        }
      }
    }
  }
}
