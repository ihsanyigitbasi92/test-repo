        "_note": "docs/design/17-analitik-ve-firebase.md §6–§7. Firebase: iki dosyayı ./firebase/ klasörüne bırakmak yeterli (app.config.js eklentileri kendisi açar). Meta: PLACEHOLDER_ değerleri Meta for Developers'taki App ID ve Client Token ile değiştirilir.",
        "applicationId": "com.d2ptechnology.motto",
        "firebase": {
          "androidGoogleServicesFile": "./firebase/google-services.json",
          "iosGoogleServicesFile": "./firebase/GoogleService-Info.plist",
          "admobLinked": true,
          "remoteConfigRequiresConsent": true
        },
        "meta": {
          "appId": "PLACEHOLDER_META_APP_ID",
          "clientToken": "PLACEHOLDER_META_CLIENT_TOKEN",
          "displayName": "Motto"
