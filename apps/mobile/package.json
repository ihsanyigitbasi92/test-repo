{
  "name": "motto-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@motto/engine": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "26.4.2",
    "@react-native-firebase/app": "26.4.2",
    "@react-native-firebase/crashlytics": "26.4.2",
    "@react-native-firebase/remote-config": "26.4.2",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-haptics": "~58.0.7",
    "expo-status-bar": "~58.0.4",
    "expo-tracking-transparency": "~58.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "17.4.0",
    "react-native-purchases": "11.0.2",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.12"
  },
  "scripts": {
    "start": "pnpm run content:packs && expo start",
    "android": "pnpm run content:packs && expo start --android",
    "ios": "pnpm run content:packs && expo start --ios",
    "web": "pnpm run content:packs && expo start --web",
    "export:web": "pnpm run content:packs && expo export --platform web && node scripts/copy-content.mjs",
    "typecheck": "tsc --noEmit",
    "gen:content": "node scripts/gen-content.mjs",
    "gen:sfx": "node scripts/gen-sfx.mjs",
    "check:sfx": "node scripts/gen-sfx.mjs --check",
    "test": "vitest run",
    "content:packs": "pnpm --filter @motto/content-schema build:packs"
  },
  "private": true
}
