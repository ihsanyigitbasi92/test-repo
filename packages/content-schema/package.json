{
  "name": "@motto/content-schema",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "node --experimental-strip-types --no-warnings --import ./scripts/ts-register.mjs scripts/validate.ts fixtures",
    "count": "node --experimental-strip-types --no-warnings --import ./scripts/ts-register.mjs scripts/count.ts",
    "redline": "node --experimental-strip-types --no-warnings --import ./scripts/ts-register.mjs scripts/redline.ts",
    "dupes": "node --experimental-strip-types --no-warnings --import ./scripts/ts-register.mjs scripts/dupes.ts",
    "check": "pnpm run validate -q && pnpm run redline && pnpm run dupes",
    "build:packs": "node --experimental-strip-types --no-warnings --import ./scripts/ts-register.mjs scripts/build-packs.ts"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
