      "tr": "ÇINAR NOTERLİĞİ (kurgusal)",
      "en": "SYCAMORE NOTARY OFFICE (fictional)"
    },
    "body": {
      "tr": "Vekil, vekâlet verenin adına banka, tapu ve diğer tüm işlemlerde tek başına yetkilidir.",
      "en": "The agent is solely authorized to act for the principal in banking, property and all other transactions."
    },
    "translate": {
      "tr": {
        "from": "diğer tüm işlemler",
        "to": "her şey; senin yerine itiraz etmek de dahil"
      },
      "en": {
        "from": "all other transactions",
        "to": "everything, including objecting on your behalf"
      }
    },
    "glossaryKey": "genel_vekalet"
  },
  "dialog": [
    {
      "speaker": "child",
      "avatar": "happy",
      "tr": "İmzalarsan bankaya ben giderim. Sen yorulma.",
      "en": "Sign it and I'll handle the bank. You rest."
    },
    {
      "speaker": "npc:clerk",
      "avatar": "neutral",
      "tr": "Vekâlet veren el yazısıyla \"okudum, anladım\" yazacak.",
      "en": "The principal must handwrite \"I have read and understood.\"",
      "delayMs": 700
    }
  ],
  "choices": [
