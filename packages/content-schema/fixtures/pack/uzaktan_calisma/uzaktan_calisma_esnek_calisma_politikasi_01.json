    },
    "body": {
      "tr": "Yeni esnek çalışma politikamız yürürlüktedir. Çalışanlarımız günlerini diledikleri gibi planlayabilir; çekirdek çalışma saatleri 09.00–18.00'dir.",
      "en": "Our new flexible work policy is now in effect. Employees may plan their days however they like; core hours are 9 a.m. to 6 p.m."
    },
    "translate": {
      "tr": {
        "from": "diledikleri gibi planlayabilir",
        "to": "09.00–18.00 arasında planlayabilir"
      },
      "en": {
        "from": "however they like",
        "to": "from nine to six"
      }
    },
    "glossaryKey": "cekirdek_saat"
  },
  "dialog": [
    {
      "speaker": "npc:coworker",
      "avatar": "tired",
      "tr": "Eskiden 09.00–18.00 çalışıyorduk. Şimdi esnek olarak 09.00–18.00 çalışıyoruz.",
      "en": "We used to work nine to six. Now we flexibly work nine to six."
    }
  ],
  "choices": [
    {
      "id": "erken",
      "tr": "Erken başla, erken bitir",
      "en": "Start early, finish early",
      "pattern": "selfCare"
