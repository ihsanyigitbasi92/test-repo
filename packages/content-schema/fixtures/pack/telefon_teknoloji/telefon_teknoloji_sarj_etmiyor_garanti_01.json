        "from": "kullanıcı kaynaklı olmayan",
        "to": "senin yapmadığın; yani hiçbiri"
      },
      "en": {
        "from": "not caused by the user",
        "to": "not your fault, which in practice is never"
      }
    },
    "glossaryKey": "kullanici_kaynakli"
