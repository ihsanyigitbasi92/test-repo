  "dialog": [
    {
      "speaker": "npc:clerk",
      "avatar": "neutral",
      "tr": "Şarj girişinde toz var. Toz kullanıcı kaynaklıdır.",
      "en": "There's lint in the charging port. Lint is user-caused."
    },
    {
      "speaker": "npc:clerk",
      "avatar": "smug",
      "tr": "Cep sizin, toz sizin. Biz sadece telefonu yaptık.",
      "en": "Your pocket, your lint. We only made the phone.",
      "delayMs": 500
    }
  ],
