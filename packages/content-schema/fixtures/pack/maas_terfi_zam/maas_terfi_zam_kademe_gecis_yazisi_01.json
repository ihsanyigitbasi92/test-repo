        "from": "mevcut ücretinizin korunması",
        "to": "zam yok"
      },
      "en": {
        "from": "preserves your current pay",
        "to": "no raise"
      }
    },
    "glossaryKey": "kademe_4b"
  },
  "dialog": [
    {
      "speaker": "npc:hr",
      "avatar": "happy",
      "tr": "Tebrikler. 4B, 4'ün bir üstü sayılır. Harfi de size kalıyor.",
      "en": "Congratulations. 4B counts as one above 4. And you keep the letter."
    }
  ],
