    "body": {
      "tr": "Gece 23.00'ten sonra çamaşır makinesini sıkmaya alan değerli komşumuza: makineniz sıkarken bütün bina da sıkılıyor.",
      "en": "To our valued neighbor who runs the spin cycle after 11 p.m.: when your machine spins, the whole building spins with it."
    },
    "translate": {
      "tr": {
        "from": "değerli komşumuza",
        "to": "sana, 3 numara"
      },
      "en": {
        "from": "our valued neighbor",
        "to": "you, unit 3"
      }
    },
    "glossaryKey": "degerli_komsumuz"
  },
  "dialog": [
    {
      "speaker": "neighbor",
      "avatar": "neutral",
      "tr": "Panoya bir not asılmış canım. Kim yazdı bilmiyorum. El yazısı güzel ama.",
      "en": "Someone put a note on the board, dear. No idea who. Lovely handwriting, though."
    }
  ],
