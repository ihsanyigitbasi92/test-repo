    },
    "translate": {
      "tr": {
        "from": "dönemsel misafir kullanımı",
        "to": "torunlar temmuzda geldi"
      },
      "en": {
        "from": "seasonal guest usage",
        "to": "the grandkids visited in July"
      }
    },
    "glossaryKey": "abone_itirazi"
  },
  "dialog": [
    {
      "speaker": "neighbor",
      "avatar": "neutral",
      "tr": "Mektubu sen yazdın, ben söyledim. Cevap sana geldi, çünkü senin e-postanı verdim.",
      "en": "You typed it, I dictated it. The reply came to you, because I gave them your email."
    }
  ],
