        "from": "bir kişi daha",
        "to": "sen"
      },
      "en": {
        "from": "one other person",
        "to": "you"
      }
    },
    "glossaryKey": "bir_kisi_daha"
  },
  "dialog": [
    {
      "speaker": "neighbor",
      "avatar": "neutral",
      "tr": "Dilekçeyi yazdım. İkinci imza lazım. Sen imzala, yönetim gençlerden çekinir.",
      "en": "I wrote the petition. It needs a second signature. You sign. The board's wary of young people."
    }
  ],
