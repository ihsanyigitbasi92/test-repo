      "tr": "KAT MALİKLERİ KURULU — UYARI YAZISI (kurgusal)",
      "en": "OWNERS' BOARD — FORMAL NOTICE (fictional)"
    },
    "body": {
      "tr": "Dairenizin giriş kapısının binanın genel görünümüyle uyumsuz bir renge boyandığı tespit edilmiştir. Uyum, kahverengi ile sağlanır.",
      "en": "Your unit's front door has been painted a color inconsistent with the building's overall appearance. Consistency is achieved with brown."
    },
    "translate": {
      "tr": {
        "from": "genel görünümüyle uyumsuz",
        "to": "kahverengi olmayan"
      },
      "en": {
        "from": "inconsistent with the building's overall appearance",
        "to": "not brown"
      }
    },
    "glossaryKey": "genel_gorunum"
  },
  "dialog": [
    {
      "speaker": "neighbor",
      "avatar": "neutral",
      "tr": "Kapın çok güzel olmuş. Ben de yeşil isterdim. Yazıyı ben yazmadım, imzaladım sadece.",
      "en": "Your door looks lovely. I wanted green myself. I didn't write the letter. I only signed it."
    }
  ],
