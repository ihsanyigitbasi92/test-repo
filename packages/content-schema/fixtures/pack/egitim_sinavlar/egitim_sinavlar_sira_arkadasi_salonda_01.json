      "id": "t",
      "tr": "Dil sınavının salonunda yerine oturdun. Yan sırada ilkokul sıra arkadaşın var; on dokuz yıldır görüşmediniz.",
      "en": "You take your seat in the language exam hall. Across the aisle: your grade-school deskmate. Nineteen years."
    }
  ],
  "dialog": [
    {
      "speaker": "npc:clerk",
      "avatar": "annoyed",
      "tr": "Konuşmak yasak. Selamlaşmak da konuşma sayılır.",
      "en": "No talking. Saying hello counts as talking."
