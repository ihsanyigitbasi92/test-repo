    "letterhead": {
      "tr": "GÜVENLİ RÜZGÂR SİGORTA (kurgusal)",
      "en": "STEADY BREEZE INSURANCE (fictional)"
    },
    "body": {
      "tr": "Önceden var olan sağlık durumları ile tehlikeli aktiviteler (doğa yürüyüşü, bisiklet, merdiven inme) poliçe kapsamı dışındadır.",
      "en": "Pre-existing conditions and hazardous activities (hiking, cycling, descending stairs) are excluded from coverage."
    },
    "translate": {
      "tr": {
        "from": "önceden var olan sağlık durumları",
        "to": "dizin bu poliçeden yaşlı"
      },
      "en": {
        "from": "pre-existing conditions",
        "to": "your knee is older than this policy"
      }
    },
    "glossaryKey": "onceden_var_olan"
  },
  "dialog": [
    {
      "speaker": "partner",
      "avatar": "worried",
      "tr": "Sigortayı okudun mu? Merdiven inmek kapsam dışıymış, otel üçüncü katta.",
      "en": "Did you read the insurance? Going down stairs isn't covered. Our room is on the third floor."
    }
  ],
